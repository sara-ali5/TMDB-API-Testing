    {
      "name": "Search Movies - Inception",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "let jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Response has results array\", function () {\r",
              "    pm.expect(jsonData.results).to.exist;\r",
              "    pm.expect(jsonData.results).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"total_results is greater than 0\", function () {\r",
              "    pm.expect(jsonData.total_results).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Each result has required fields\", function () {\r",
              "    jsonData.results.forEach(movie => {\r",
              "        pm.expect(movie.id).to.exist;\r",
              "        pm.expect(movie.title).to.exist;\r",
              "        pm.expect(movie.release_date).to.exist;\r",
              "        pm.expect(movie.overview).to.exist;\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Titles are relevant to search keyword\", function () {\r",
              "    const keyword = \"inception\".toLowerCase();\r",
              "\r",
              "    let relevant = jsonData.results.some(movie =>\r",
              "        movie.title.toLowerCase().includes(keyword)\r",
              "    );\r",
              "\r",
              "    pm.expect(relevant).to.be.true;\r",
              "});"
